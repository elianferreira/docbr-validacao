# Copie para .env. Segredo nunca vai para o git (no k8s a config vem por Secret).
# Grava a imagem exatamente como ela chega ao Tesseract — so para diagnostico local,
# porque a imagem de documento e dado pessoal.
Ocr__PastaDeDiagnostico=
Ocr__TamanhoMaximoBytes=20971520
RateLimit__DocumentosPorMinuto=60
RateLimit__OcrPorMinuto=10
