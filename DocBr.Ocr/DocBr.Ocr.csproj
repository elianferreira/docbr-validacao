<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocBr.Validacao\DocBr.Validacao.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <!-- SkiaSharp gerenciado e NativeAssets tem que casar na mesma versao, senao o
         type initializer estoura em runtime com as DLLs nativas presentes. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
    <!-- O deploy roda em OracleLinux 10: sem os NativeAssets de Linux o SkiaSharp estoura em
         runtime no container. As tres versoes (gerenciada e as duas nativas) tem que casar. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tessdata\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
